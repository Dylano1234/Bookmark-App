<UserControl x:Class="Bookmark_App.Views.SyncChoiceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Bookmark_App.Views"
             xmlns:viewmodels="clr-namespace:Bookmark_App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:SyncChoiceViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <!-- Title Field -->
        <TextBlock Text="Sync Conflict Detected"
               Foreground="White"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,5" 
               HorizontalAlignment="Center"/>
        <TextBlock Text="Your local database and your cloud backup are different. Choose which one to keep."
                   Foreground="LightGray"
                   FontSize="14"
                   FontWeight="Bold"
                   Margin="0,0,0,20" 
                   HorizontalAlignment="Center"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <!-- Local Option -->
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="Local Data"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Last saved:"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LocalLastSaved}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>
                <Button Content="Keep Local"
                        Width="120"
                        Margin="0,52,0,0"
                        Command="{Binding KeepLocalCommand}"/>
            </StackPanel>
            <!-- Cloud Option -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock Text="Cloud Data"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Last saved:"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CloudLastSaved}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Device:"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,0" 
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CloudSaveDevice}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,10" 
                           HorizontalAlignment="Center"/>
                <Button Content="Overwrite from cloud"
                        Width="120"
                        Command="{Binding GetCloudCommand}"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
