<UserControl x:Class="Bookmark_App.Views.ListItemCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:m="clr-namespace:Bookmark_App.Models"
             xmlns:local="clr-namespace:Bookmark_App.Views" xmlns:viewmodels="clr-namespace:Bookmark_App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ListViewModel}"
             mc:Ignorable="d" 

             MinHeight="80">
    <Border CornerRadius="18"
            Background="#292929"
            Padding="10"
            Margin="4">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#555"/>
                <Setter Property="BorderThickness" Value="3"/>

                <Style.Triggers>

                    <!-- Planning -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.Planning}">
                        <Setter Property="BorderBrush" Value="Gray"/>
                    </DataTrigger>

                    <!-- In Progress -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.InProgress}">
                        <Setter Property="BorderBrush" Value="Green"/>
                    </DataTrigger>

                    <!-- Completed -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.Completed}">
                        <Setter Property="BorderBrush" Value="MidnightBlue"/>
                    </DataTrigger>

                    <!-- On Hold -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.OnHold}">
                        <Setter Property="BorderBrush" Value="Orange"/>
                    </DataTrigger>

                    <!-- Dropped -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.Dropped}">
                        <Setter Property="BorderBrush" Value="DarkRed"/>
                    </DataTrigger>

                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- cover -->
                <ColumnDefinition Width="10*"/>
                <!-- titel + genres -->
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="*" />
                <!-- rating + progress + detail -->
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>

            <!-- COVER LINKS -->
            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border
                    Width="96"
                    Height="96"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#707070"
                    Background="#3A3A3A"
                    VerticalAlignment="Center"
                    Margin="4,0,12,0"
                    ClipToBounds="True">
                    <Border Grid.Column="0"
                        Width="96"
                        Height="96"
                        CornerRadius="48"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding coverImage}"
                                    Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Border>
            </Viewbox>

            <!-- TITEL + URL + GENRES -->

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">

                        <!-- Titel -->
                        <TextBlock Text="{Binding title}"
                                   FontWeight="Bold"
                                   FontSize="32"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Open URL -->
                        <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding url}"
                                Margin="6,0,0,0"
                                Padding="0"
                                Width="18" Height="18"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTip="Open link"
                                Cursor="Hand">

                            <TextBlock Text="↗"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#AAAAAA"
                                       VerticalAlignment="Center"/>
                            <Button.Template>
                                <!-- Use a Border bound to the Button.Background so the control has a hit-testable area even when Background is Transparent -->
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            Cursor="{TemplateBinding Cursor}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>


                    <!-- Genres -->
                    <TextBlock Text="{Binding GenresText}"
                            FontSize="24"
                            Foreground="#BBBBBB"
                            Margin="0,4,0,0"
                            TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>


            <!-- RECHTERKANT: rating + progress + detail -->
            <Viewbox Grid.Column="3" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        >

                    <!-- Rating in cirkel: '2/10' -->
                    <Border Width="84"
                        Height="84"
                        CornerRadius="42"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Background="Transparent"
                        VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform">
                            <TextBlock Text="{Binding rating, StringFormat='{}{0:0.#}/10'}"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Viewbox>
                    </Border>

                    <!-- Progress + '+' knop -->
                    <StackPanel VerticalAlignment="Center"
                            Margin="10,0,0,0">
                        <TextBlock Text="Progress:"
                               Foreground="White"
                               FontSize="24"
                               HorizontalAlignment="Left"/>
                        <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                 HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProgressText}"  
                                   Foreground="White"
                                   FontSize="24"
                                   VerticalAlignment="Center"/>

                            <!-- '+' knop -->
                            <Button Content="+"
                                Width="48"
                                Height="48"
                                Command="{Binding IncrementProgressCommand}"
                                Margin="4,0,0,0"
                                Background="#3A3A3A"
                                Foreground="White"
                                BorderBrush="#707070"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                FontSize="32">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border CornerRadius="24"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            Cursor="{TemplateBinding Cursor}"
                                            BorderThickness="1">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- '>' detail-knop -->
                    <Button Width="64"
                        Height="64"
                        Content=">"
                        Command="{Binding OpenDetailCommand}"
                        Background="#3A3A3A"
                        Foreground="White"
                        BorderBrush="#707070"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        Margin="10,0,0,0"
                        Cursor="Hand"
                        FontSize="32">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="32"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Cursor="{TemplateBinding Cursor}"
                                    BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
