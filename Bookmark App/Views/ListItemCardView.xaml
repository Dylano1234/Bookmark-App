<UserControl x:Class="Bookmark_App.Views.ListItemCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:m="clr-namespace:Bookmark_App.Models"
             xmlns:local="clr-namespace:Bookmark_App.Views" xmlns:viewmodels="clr-namespace:Bookmark_App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ListViewModel}"
             mc:Ignorable="d" 

             MinHeight="80">
    <Border CornerRadius="18"
            Background="#292929"
            Padding="10"
            Margin="4">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#555"/>
                <Setter Property="BorderThickness" Value="3"/>

                <Style.Triggers>

                    <!-- Planning -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.Planning}">
                        <Setter Property="BorderBrush" Value="Gray"/>
                    </DataTrigger>

                    <!-- In Progress -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.InProgress}">
                        <Setter Property="BorderBrush" Value="Green"/>
                    </DataTrigger>

                    <!-- Completed -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.Completed}">
                        <Setter Property="BorderBrush" Value="MidnightBlue"/>
                    </DataTrigger>

                    <!-- On Hold -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.OnHold}">
                        <Setter Property="BorderBrush" Value="Orange"/>
                    </DataTrigger>

                    <!-- Dropped -->
                    <DataTrigger Binding="{Binding status}" Value="{x:Static m:ItemStatus.Dropped}">
                        <Setter Property="BorderBrush" Value="DarkRed"/>
                    </DataTrigger>

                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- cover -->
                <ColumnDefinition Width="10*"/>
                <!-- titel + genres -->
                <ColumnDefinition Width="60*" />
                <ColumnDefinition Width="*" />
                <!-- rating + progress + detail -->
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>

            <!-- COVER LINKS -->
            <Viewbox Grid.Column="0" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border
                    Width="96"
                    Height="96"
                    CornerRadius="48"
                    BorderThickness="1"
                    BorderBrush="#707070"
                    Background="#3A3A3A"
                    VerticalAlignment="Center"
                    Margin="4,0,12,0"
                    ClipToBounds="True">
                    <Border Grid.Column="0"
                        Width="96"
                        Height="96"
                        CornerRadius="48"
                        VerticalAlignment="Center"
                        ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding coverImage}"
                                    Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Border>
            </Viewbox>

            <!-- TITEL + URL + GENRES -->

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">

                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">

                        <!-- Titel -->
                        <TextBlock Text="{Binding title}"
                                   FontWeight="Bold"
                                   FontSize="32"
                                   Foreground="White"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Open URL -->
                        <Button Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding url}"
                                Margin="6,0,0,0"
                                Padding="0"
                                Width="18" Height="18"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTip="Open link"
                                Cursor="Hand">

                            <TextBlock Text="↗"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#AAAAAA"
                                       VerticalAlignment="Center"/>
                            <Button.Template>
                                <!-- Use a Border bound to the Button.Background so the control has a hit-testable area even when Background is Transparent -->
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            Cursor="{TemplateBinding Cursor}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>


                    <!-- Genres -->
                    <TextBlock Text="{Binding GenresText}"
                            FontSize="24"
                            Foreground="#BBBBBB"
                            Margin="0,4,0,0"
                            TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>


            <!-- RECHTERKANT: rating + progress + detail -->
            <Viewbox Grid.Column="3" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Rating in cirkel: '2/10' -->
                    <Border Width="84"
                            Height="84"
                            CornerRadius="42"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Grid.Column="0">
                        <Viewbox Stretch="Uniform">
                            <TextBlock Foreground="White"
                                       Margin="2,0,2,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- standaard: normale rating -->
                                        <Setter Property="Text"
                                                Value="{Binding rating, StringFormat='{}{0:0.#}/10'}" />

                                        <Style.Triggers>
                                            <!-- als rating 0 is -->
                                            <DataTrigger Binding="{Binding rating}" Value="0">
                                                <Setter Property="Text" Value="?/10" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Viewbox>
                    </Border>

                    <!-- Progress + '+' knop -->
                    <Viewbox Stretch="Uniform" StretchDirection="UpOnly"
                             Grid.Column="1">
                        <StackPanel VerticalAlignment="Center"
                                Margin="20,0,10,0">
                            <TextBlock Text="Progress:"
                                   Foreground="White"
                                   FontSize="24"
                                   HorizontalAlignment="Left"/>
                            <Viewbox Stretch="Uniform" StretchDirection="Both"> 
                                <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                     HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressText}"  
                                           Foreground="White"
                                           FontSize="24"
                                           VerticalAlignment="Center"/>

                                    <!-- '+' knop -->
                                    <Button Content="+"
                                        Width="38"
                                        Height="38"
                                        Command="{Binding DataContext.IncrementProgressCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ListView}}}"
                                        CommandParameter="{Binding}"
                                        Margin="4,0,0,0"
                                        Background="#3A3A3A"
                                        Foreground="White"
                                        BorderBrush="#707070"
                                        FontWeight="Bold"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        FontSize="24">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="24"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Cursor="{TemplateBinding Cursor}"
                                                    BorderThickness="1">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Viewbox>
                        </StackPanel>
                    </Viewbox>
                    <!-- '>' detail-knop -->
                    <Button Width="64"
                            Height="64"
                            Content=">"
                            Command="{Binding DataContext.OpenListItemDetailViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Background="#3A3A3A"
                            Foreground="White"
                            BorderBrush="#707070"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Cursor="Hand"
                            ToolTip="View Details and Edit Item"
                            FontSize="32"
                            Grid.Column="2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="32"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Cursor="{TemplateBinding Cursor}"
                                    BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</UserControl>
