<Window x:Class="Bookmark_App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Bookmark_App.ViewModels"
        xmlns:views="clr-namespace:Bookmark_App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" d:DataContext="{d:DesignInstance Type=vm:ListCreationViewModel}"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        MinHeight="400"
        MinWidth="600">

    <Window.Resources>
        <!-- TEMPLATE: HomeViewModel → HomeView -->
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <!-- TEMPLATE: ListViewModel → ListView (ensures Title binding in ListView.xaml works) -->
        <DataTemplate DataType="{x:Type vm:ListViewModel}">
            <views:ListView />
        </DataTemplate>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
    </Window.Resources>
    

    <Grid>
        <Grid Background="#222">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="80*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Left">
                <StackPanel Background="#222" Grid.Column="0">
                    <Button Content="Home" 
                    Background="#222" 
                    Foreground="White"
                    BorderBrush="#222"
                    Margin="10,10,10,0"
                    HorizontalContentAlignment="Left"
                            Command="{Binding OpenHomeCommand}"/>
                    <!-- lijstknoppen -->
                    <ItemsControl ItemsSource="{Binding Lists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding title}" 
                                Background="#222" 
                                Foreground="White"
                                BorderBrush="#222"
                                Margin="10,5,10,0"
                                HorizontalContentAlignment="Left"
                                Command="{Binding DataContext.OpenListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{DynamicResource ButtonStyle1}" Content="+" 
                    Background="#333" 
                    Foreground="White"
                    BorderBrush="#333"
                    Margin="10,5,10,0"
                    Width="20"
                    Height="20"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Left"
                    FontSize="12"
                    Command="{Binding OpenCreateListCommand}"
                    CommandParameter="{StaticResource TrueValue}"/>
                    <Button Style="{DynamicResource ButtonStyleDummy}" Background="#222"
                    BorderBrush="#222"
                    Width="100"
                    />
                </StackPanel>
            </Viewbox>
            <!-- Dynamische content -->
            <ContentControl Grid.Column="1"
                    Content="{Binding CurrentViewModel}" />
        </Grid>
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreateListOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Center"
                     Margin="50,50,50,50">
                <Border Width="500"
                        Padding="20"
                        Background="#292929"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <views:ListCreationView DataContext="{Binding CreateListViewModel}" />
                </Border>
            </Viewbox>
        </Grid>
        <Grid Background="#80000000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsListItemDetailViewOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Center"
                     Margin="50,50,50,50">
                <Border Width="600"
                        Padding="20"
                        Background="#292929"
                        CornerRadius="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <views:ListItemDetailView DataContext="{Binding ListItemDetailViewModel}" />
                </Border>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
