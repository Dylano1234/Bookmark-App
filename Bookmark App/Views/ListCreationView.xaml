<UserControl x:Class="Bookmark_App.Views.ListCreationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bookmark_App.Views"
             xmlns:vm="clr-namespace:Bookmark_App.ViewModels"
             xmlns:views="clr-namespace:Bookmark_App.Views" d:DataContext="{d:DesignInstance Type=vm:ListCreationViewModel}"
             mc:Ignorable="d" 
             MinHeight="300"
             MinWidth="500">
    <StackPanel>
        <!-- velden voor titel, cover, etc. -->
        <TextBlock Text="{Binding WindowTitle}"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   Margin="0,0,0,20" 
                   HorizontalAlignment="Center">
            
        </TextBlock>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <TextBlock Text="Title:"
                           Foreground="White"/>
                <TextBox Width="100"
                         Foreground="White"
                         Background="#444"
                         BorderBrush="#444"
                         Text="{Binding ListTitle, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <!-- Rechter kant: uploadvak -->
            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <!-- Vak met afbeelding of placeholder -->
                <Border Width="260"
                        Height="180"
                        CornerRadius="12"
                        BorderBrush="#666"
                        BorderThickness="1"
                        Margin="0,0,0,10">

                    <!-- Preview-image -->
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding CoverPreview}"
                                    Stretch="UniformToFill"/>
                    </Border.Background>
                    <Grid>
                        <!-- Placeholder -->
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <!-- standaard verborgen -->
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <!-- Als CoverPreview null is → tonen -->
                                        <DataTrigger Binding="{Binding CoverPreview}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="No image selected"
                                       Foreground="#AAAAAA"
                                       TextAlignment="Center"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="Press 'Upload Image'"
                                       Foreground="#777"
                                       FontSize="11"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Upload-knop -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                    <Button Content="Upload Image"
                            Command="{Binding SelectImageCommand}"
                            Padding="12,4"
                            HorizontalAlignment="Center"
                            Margin="0,0,10,0"
                            Foreground="White"
                            Background="#444"
                            BorderBrush="#444"/>
                    <Button Content="Remove Image"
                            Command="{Binding RemoveImageCommand}"
                            Padding="12,4"
                            HorizontalAlignment="Center"
                            Foreground="White"
                            Background="#444"
                            BorderBrush="#444"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"  Margin="0,0,0,70">
                    <Grid>
                        <TextBox x:Name="ImageLinkTextBox" Width="126"
                                 Height="30"
                                 Margin="0,5,10,5"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontSize="16"
                                 Foreground="White"
                                 Background="#444"
                                 BorderBrush="#333"
                                 Text="{Binding ImageLink, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>
                        <TextBlock Text="Paste image link here"
                                   Foreground="Gray"
                                   Margin="5,10,0,5"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ImageLinkTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Content="Fetch Image"
                            Height="30"
                            Command="{Binding FetchImageCommand}"
                            Width="80"
                            HorizontalAlignment="Center"
                            Foreground="White"
                            Background="#444"
                            BorderBrush="#444"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Margin="0,0,10,0"
                    Command="{Binding DataContext.CloseCreateListCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Content="Save"
                    Margin="0,0,10,0"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Command="{Binding SaveListCommand}" />
            <Button Content="Delete"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Command="{Binding DeleteListCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
