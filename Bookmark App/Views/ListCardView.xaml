<UserControl x:Class="Bookmark_App.Views.ListCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bookmark_App.Views"
             xmlns:vm="clr-namespace:Bookmark_App.ViewModels"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             Height="180"
             Width="260">


    <UserControl.Resources>
        <System:Boolean x:Key="FalseValue">False</System:Boolean>
        <System:Boolean x:Key="TrueValue">True</System:Boolean>
    </UserControl.Resources>



    <Border CornerRadius="16"
            Margin="8"
            SnapsToDevicePixels="True"
            ClipToBounds="True"
            Background="Gray">
        <Border CornerRadius="16"
                Margin="0"
                SnapsToDevicePixels="True"
                ClipToBounds="True">
            <Border.Background>
                <ImageBrush ImageSource="{Binding coverImage}"
                            Stretch="UniformToFill"/>
            </Border.Background>


            <Grid>
                <!-- Donkere overlay onderaan met afgeronde onderhoeken -->
                <Border Background="#80000000"
                        VerticalAlignment="Bottom"
                        CornerRadius="0,0,16,16">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding title}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Bottom" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding itemCount, StringFormat='{}{0} items'}"
                                   Foreground="#DDDDDD"
                                   FontSize="12"
                                   VerticalAlignment="Bottom"
                                   Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <Button
                    Command="{Binding DataContext.OpenListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Focusable="False"
                    ToolTip="Open list"
                    Cursor="Hand">        
                    <Button.Template>
                        <!-- Use a Border bound to the Button.Background so the control has a hit-testable area even when Background is Transparent -->
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    Cursor="{TemplateBinding Cursor}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Top-right round button -->
                <Button Width="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        ToolTip="Options"
                        Cursor="Hand"
                        Focusable="False"
                        Panel.ZIndex="2"
                        Command="{Binding DataContext.OpenEditListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}">
                <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Width="{TemplateBinding Width}"
                                    Height="{TemplateBinding Height}"
                                    CornerRadius="18"
                                    Background="#3A3A3A"
                                    BorderBrush="#707070"
                                    BorderThickness="1"
                                    Cursor="{TemplateBinding Cursor}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock Text="..."
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,0,0,10"/>
                </Button>
            </Grid>
        </Border>
    </Border>
    
</UserControl>
