<UserControl x:Class="Bookmark_App.Views.ListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Bookmark_App.ViewModels"
             xmlns:views="clr-namespace:Bookmark_App.Views" d:DataContext="{d:DesignInstance Type=vm:ListViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="15*" 
                       MinHeight="60"/>
            <RowDefinition Height="8*" 
                           MinHeight="60"/>
            <RowDefinition Height="77*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#292929" MinHeight="60">
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Margin="0">
                    <TextBlock Text="{Binding Title}"
                   Foreground="White"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Left"
                   Margin="10,0,0,0"/>
                </StackPanel>
            </Viewbox>
        </Border>
        <Border Grid.Row="1" MinHeight="60">
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20*"
                                          MinWidth="100"/>
                        <ColumnDefinition Width="20*"
                                          MinWidth="100"/>
                        <ColumnDefinition Width="20*"
                                          MinWidth="100"/>
                        <ColumnDefinition Width="20*"
                                          MinWidth="100"/>
                        <ColumnDefinition Width="20*"
                                          MinWidth="100"/>
                        <ColumnDefinition Width="20*"
                                          MinWidth="100"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="All"
                        Background="MidnightBlue"
                        Foreground="White"
                        FontSize="20"
                        BorderBrush="MidnightBlue"
                        VerticalContentAlignment="Center"
                            Grid.Column="0"/>
                    <Button Content="In Progress"
                            Background="Green"
                            Foreground="White"
                            FontSize="20"
                            BorderBrush="Green"
                            VerticalContentAlignment="Center"
                            Grid.Column="1"/>
                    <Button Content="Completed"
                            Background="MidnightBlue"
                            Foreground="White"
                            FontSize="20"
                            BorderBrush="MidnightBlue"
                            VerticalContentAlignment="Center"
                            Grid.Column="2"/>
                    <Button Content="On Hold"
                            Background="Orange"
                            Foreground="White"
                            FontSize="20"
                            BorderBrush="Orange"
                            VerticalContentAlignment="Center"
                            Grid.Column="3"/>
                    <Button Content="Dropped"
                            Background="DarkRed"
                            Foreground="White"
                            FontSize="20"
                            BorderBrush="DarkRed"
                            VerticalContentAlignment="Center"
                            Grid.Column="4"/>
                    <Button Content="Planning"
                            Background="Gray"
                            Foreground="White"
                            FontSize="20"
                            BorderBrush="Gray"
                            VerticalContentAlignment="Center"
                            Grid.Column="5"/>
                </Grid>
            </Viewbox>
        </Border>
        <Border Grid.Row="2" MinHeight="60">

        </Border>
    </Grid>
</UserControl>
