<UserControl x:Class="Bookmark_App.Views.ListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Bookmark_App.ViewModels"
             xmlns:m="clr-namespace:Bookmark_App.Models"
             xmlns:views="clr-namespace:Bookmark_App.Views" d:DataContext="{d:DesignInstance Type=vm:ListViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#555"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a4a4a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>

                            <!-- flat square border -->
                            <Border x:Name="Border"
                                Grid.ColumnSpan="2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="4" />

                            <!-- selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                          Grid.Column="0"
                                          Margin="3,0,4,0"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          VerticalAlignment="Center" />

                            <!-- toggle button with hollow 'V' arrow -->
                            <ToggleButton Grid.Column="1"
                                      Focusable="false"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Width="20" Height="20"
                                      Padding="0" Margin="0">
                                <Viewbox Width="12" Height="12">
                                    <!-- V shape (outlined) -->
                                    <Path Data="M1,2 L6,8 L11,2"
                                      Fill="Transparent"
                                      Stroke="White"
                                      StrokeThickness="1.4"
                                      StrokeLineJoin="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      Stretch="Uniform" />
                                </Viewbox>
                            </ToggleButton>

                            <!-- popup; ensure it matches combobox width -->
                            <Popup x:Name="Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="20*" 
                       MinHeight="60"/>
            <RowDefinition Height="8*" 
                           MinHeight="30"/>
            <RowDefinition Height="65*" />
            <RowDefinition Height="7*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#292929" MinHeight="60">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280*" />
                    <ColumnDefinition Width="120*"/>
                    <ColumnDefinition Width="180*"/>
                    <ColumnDefinition Width="150*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Viewbox Grid.Column="0" Grid.ColumnSpan="3" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Left"
                                   Margin="10,0,0,5"
                                   Grid.Column="0"/>
                </Viewbox>
                <Viewbox Grid.Column="3" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Style="{DynamicResource ButtonStyle1}" Content="+" 
                            Background="#333" 
                            Foreground="White"
                            BorderBrush="#333"
                            Margin="5,5,5,5"
                            Width="15"
                            Height="15"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Left"
                            FontSize="10"
                            Command="{Binding DataContext.OpenListItemDetailViewNewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Cursor="Hand"
                            ToolTip="Add new item to the list">
                    </Button>
                </Viewbox>
                <Viewbox Grid.Column="1" Grid.Row="1" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ComboBox Width="120"
                              Height="30"
                              Style="{StaticResource FlatComboBox}"
                              Margin="0,0,10,5"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              FontSize="10"
                              SelectedItem="{Binding SelectedGenreSortOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}"  
                                           FontSize="16" 
                                           Padding="4"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Viewbox>
                <Viewbox Grid.Column="2" Grid.Row="1" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ComboBox Width="180"
                              Height="30"
                              Style="{StaticResource FlatComboBox}"
                              Margin="10,0,10,5"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Right"
                              FontSize="10"
                              SelectedItem="{Binding SelectedSortingOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding SortingOptions}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"  
                                           FontSize="16" 
                                           Padding="4"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Viewbox>
                <Viewbox Grid.Column="3" Grid.Row="1" Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Grid>
                        <TextBox x:Name="FilterTextBox" Width="150"
                                 Height="30"
                                 Margin="10,0,20,5"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Right"
                                 FontSize="16"
                                 Foreground="White"
                                 Background="#3A3A3A"
                                 BorderBrush="#707070"
                                 Text="{Binding FilteringTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        </TextBox>
                        <TextBlock Text="Search by Title"
                                   Foreground="Gray"
                                   Margin="15,5,20,5"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
        <Border Grid.Row="1" MinHeight="60">
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"
                                          MinWidth="130"/>
                        <ColumnDefinition Width="1*"
                                          MinWidth="130"/>
                        <ColumnDefinition Width="1*"
                                          MinWidth="130"/>
                        <ColumnDefinition Width="1*"
                                          MinWidth="130"/>
                        <ColumnDefinition Width="1*"
                                          MinWidth="130"/>
                        <ColumnDefinition Width="1*"
                                          MinWidth="130"/>
                    </Grid.ColumnDefinitions>
                    <!-- All -->
                    <Button Content="All"
                            Background="DarkSlateBlue"
                            Foreground="White"
                            FontSize="20"
                            VerticalContentAlignment="Center"
                            Grid.Column="0"
                            Command="{Binding SetStatusCommand}"
                            CommandParameter="{x:Static m:ItemStatus.All}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ItemStatus.All}">
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- In Progress -->
                    <Button Content="In Progress"
                            Background="Green"
                            Foreground="White"
                            FontSize="20"
                            VerticalContentAlignment="Center"
                            Grid.Column="1"
                            Command="{Binding SetStatusCommand}"
                            CommandParameter="{x:Static m:ItemStatus.InProgress}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ItemStatus.InProgress}">
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Completed -->
                    <Button Content="Completed"
                            Background="MidnightBlue"
                            Foreground="White"
                            FontSize="20"
                            VerticalContentAlignment="Center"
                            Grid.Column="2"
                            Command="{Binding SetStatusCommand}"
                            CommandParameter="{x:Static m:ItemStatus.Completed}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ItemStatus.Completed}">
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- On Hold -->
                    <Button Content="On Hold"
                            Background="Orange"
                            Foreground="White"
                            FontSize="20"
                            VerticalContentAlignment="Center"
                            Grid.Column="3"
                            Command="{Binding SetStatusCommand}"
                            CommandParameter="{x:Static m:ItemStatus.OnHold}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ItemStatus.OnHold}">
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Dropped -->
                    <Button Content="Dropped"
                            Background="DarkRed"
                            Foreground="White"
                            FontSize="20"
                            VerticalContentAlignment="Center"
                            Grid.Column="4"
                            Command="{Binding SetStatusCommand}"
                            CommandParameter="{x:Static m:ItemStatus.Dropped}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ItemStatus.Dropped}">
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Planning -->
                    <Button Content="Planning"
                            Background="Gray"
                            Foreground="White"
                            FontSize="20"
                            VerticalContentAlignment="Center"
                            Grid.Column="5"
                            Command="{Binding SetStatusCommand}"
                            CommandParameter="{x:Static m:ItemStatus.Planning}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:ItemStatus.Planning}">
                                        <Setter Property="BorderBrush" Value="White"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Viewbox>
        </Border>
        <Border Grid.Row="2" MinHeight="60" Margin="8,0,8,0">
            <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Top">
                <!-- Use a Grid to show either the ItemsControl or a 'No Items found' message -->
                <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Top" HorizontalAlignment="Center">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>

                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- vertical stacking so ScrollViewer handles vertical scrolling -->
                                    <StackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:ListItemCardView />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Shown when there are no items -->
                        <TextBlock Text="No Items found"
                               Foreground="Gray"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                                   Margin="100,0,100,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Viewbox>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="3" MinHeight="20">
            <Viewbox Stretch="Uniform" StretchDirection="Both" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Width="32"
                            Height="32"
                            Content="&lt;&lt;"
                            Command="{Binding FirstPageCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            BorderBrush="#707070"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,5,5"
                            Cursor="Hand"
                            ToolTip="Go to first page"
                            FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="32"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Cursor="{TemplateBinding Cursor}"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="1"
                            Width="32"
                            Height="32"
                            Content="&lt;"
                            Command="{Binding PreviousPageCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            BorderBrush="#707070"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,5,5"
                            Cursor="Hand"
                            ToolTip="Previous page"
                            FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="32"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Cursor="{TemplateBinding Cursor}"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Grid.Column="2"
                                Text="{Binding CurrentPage}"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Left"
                               Margin="5,0,5,5"/>
                    <Button Grid.Column="3"
                            Width="32"
                            Height="32"
                            Content=">"
                            Command="{Binding NextPageCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            BorderBrush="#707070"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,5,5"
                            Cursor="Hand"
                            ToolTip="Next page"
                            FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="32"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Cursor="{TemplateBinding Cursor}"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Grid.Column="4"
                            Width="32"
                            Height="32"
                            Content=">>"
                            Command="{Binding LastPageCommand}"
                            Background="#3A3A3A"
                            Foreground="White"
                            BorderBrush="#707070"
                            FontWeight="Bold"
                            VerticalAlignment="Center"
                            Margin="0,0,5,5"
                            Cursor="Hand"
                            ToolTip="Go to last page"
                            FontSize="12">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="32"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        Cursor="{TemplateBinding Cursor}"
                                        BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Viewbox>
        </Border>
    </Grid>
</UserControl>
