<UserControl x:Class="Bookmark_App.Views.ListItemDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bookmark_App.Views" xmlns:viewmodels="clr-namespace:Bookmark_App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ListItemDetailViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <!-- Title Field -->
        <TextBlock Text="{Binding HeaderTitle}"
               Foreground="White"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,20" 
               HorizontalAlignment="Center"/>
        <Grid> <!-- Detail View when IsEditMode = False-->
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property= "Visibility"  Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Information Fields -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Title:"
                   Foreground="White"/>
                    <TextBox Width="130"
                 Height="40"
                 TextWrapping="Wrap"
                 Text="{Binding CurrentListItem.title, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>
                    <TextBlock Text="Current Progress:"
                   Foreground="White"/>
                    <TextBox Width="130"
                 Text="{Binding CurrentListItem.progressCurrent, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>
                    <TextBlock Text="Rating:"
                   Foreground="White"/>
                    <TextBox Width="130"
                 Text="{Binding CurrentListItem.rating, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Url:"
                   Foreground="White"/>
                    <TextBox Width="130"
                 Height="40"
                 TextWrapping="Wrap"
                 Text="{Binding CurrentListItem.url, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>
                    <TextBlock Text="Max Progress:"
                    Foreground="White"/>
                    <TextBox Width="130"
                 Text="{Binding CurrentListItem.progressMax, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>
                    <TextBlock Text="Status:"
                   Foreground="White"/>
                    <TextBox Width="130"
                 Text="{Binding CurrentListItem.status, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="True"
                 Margin="0,0,0,10"/>


                </StackPanel>
                <!-- Rechter kant: uploadvak -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Vak met afbeelding of placeholder -->
                    <Border Width="200"
                            Height="260"
                            CornerRadius="12"
                            BorderBrush="#666"
                            BorderThickness="1"
                            Background="#333"
                            Margin="0,0,0,10">
                        <Grid>
                            <!-- Preview-image -->
                            <Image Source="{Binding CurrentListItem.coverImage}"
                                   Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- Placeholder -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <!-- standaard verborgen -->
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- Als CoverPreview null is → tonen -->
                                            <DataTrigger Binding="{Binding CurrentListItem.coverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="No image found"
                                           Foreground="#AAAAAA"
                                           TextAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Press 'Edit' to add an image"
                                           Foreground="#777"
                                           FontSize="11"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                    <TextBlock Text="Genres:"
                               Foreground="White"
                               Margin="0,0,0,0"/>
                    <TextBox Width="120"
                             Height="25"
                             FontSize="14"
                        Text="{Binding CurrentListItem.genres[0].name, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="True"
                        Margin="0,0,10,0"/>
                </StackPanel>
                <TextBox Width="120"
                         Height="25"
                         VerticalAlignment="Bottom"
                         FontSize="14"
                        Text="{Binding CurrentListItem.genres[1].name, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="True"
                        Margin="0,0,10,0"/>
                <TextBox Width="120"
                         Height="25"
                         VerticalAlignment="Bottom"
                         FontSize="14"
                        Text="{Binding CurrentListItem.genres[2].name, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="True"
                        Margin="0,0,10,0"/>
                <TextBox Width="120"
                         Height="25"
                         VerticalAlignment="Bottom"
                         FontSize="14"
                        Text="{Binding CurrentListItem.genres[3].name, UpdateSourceTrigger=PropertyChanged}" 
                        IsReadOnly="True"
                        Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>

        <Grid> <!-- Edit Mode when IsEditMode = True-->    
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property= "Visibility"  Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Information Fields -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Title:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Height="40"
                             TextWrapping="Wrap"
                             Text="{Binding CurrentListItem.title, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10"/>
                    <TextBlock Text="Current Progress:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Text="{Binding CurrentListItem.progressCurrent, UpdateSourceTrigger=LostFocus}" 
                             Margin="0,0,0,10"/>
                    <TextBlock Text="Rating:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Text="{Binding CurrentListItem.rating, UpdateSourceTrigger=LostFocus}" 
                             Margin="0,0,0,10"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Url:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Height="40"
                             TextWrapping="Wrap"
                             Text="{Binding CurrentListItem.url, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,10,10"/>
                    <TextBlock Text="Max Progress:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Text="{Binding CurrentListItem.progressMax, UpdateSourceTrigger=LostFocus}" 
                             Margin="0,0,10,10"/>
                    <TextBlock Text="Status:"
                                Foreground="White"/>
                    <ComboBox Width="130"
                              Margin="0,0,10,5"
                              Foreground="Black"
                              Background="#3A3A3A"
                              BorderBrush="#707070"
                              SelectedValue="{Binding CurrentListItem.status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Statuses}"/>


                </StackPanel>
                <!-- Rechter kant: uploadvak -->
                <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <!-- Vak met afbeelding of placeholder -->
                    <Border Width="200"
                    Height="260"
                    CornerRadius="12"
                    BorderBrush="#666"
                    BorderThickness="1"
                    Background="#333"
                    Margin="0,0,0,10">
                        <Grid>
                            <!-- Preview-image -->
                            <Image Source="{Binding CurrentListItem.coverImage}"
                                    Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- Placeholder -->
                            <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <!-- standaard verborgen -->
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- Als CoverPreview null is → tonen -->
                                            <DataTrigger Binding="{Binding CurrentListItem.coverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="No image selected"
                                   Foreground="#AAAAAA"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                                <TextBlock Text="Press 'Upload Image'"
                                   Foreground="#777"
                                   FontSize="11"
                                   TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Upload-knop -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Upload Image"
                                Command="{Binding SelectImageCommand}"
                                Padding="12,4"
                                HorizontalAlignment="Center"
                                        Margin="0,0,10,0"/>
                        <Button Content="Remove Image"
                                Command="{Binding RemoveImageCommand}"
                                Padding="12,4"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                    <TextBlock Text="Genres:"
                               Foreground="White"
                               Margin="0,0,0,0"/>
                    <ComboBox Width="120"
                               Height="25"
                            VerticalAlignment="Bottom"
                          Margin="0,0,10,5"
                          Foreground="Black"
                          Background="#3A3A3A"
                          BorderBrush="#707070"
                          SelectedItem="{Binding Genre1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}" 
                                       Foreground="Black" 
                                       FontSize="14"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <ComboBox Width="120"
                           Height="25"
                            VerticalAlignment="Bottom"
                          Margin="0,0,10,5"
                          Foreground="Black"
                          Background="#3A3A3A"
                          BorderBrush="#707070"
                          SelectedItem="{Binding Genre2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Genres}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding name}" 
                                       Foreground="Black" 
                                       FontSize="14"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Width="120"
                           Height="25"
                            VerticalAlignment="Bottom"
                          Margin="0,0,10,5"
                          Foreground="Black"
                          Background="#3A3A3A"
                          BorderBrush="#707070"
                          SelectedItem="{Binding Genre3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Genres}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding name}" 
                       Foreground="Black" 
                       FontSize="14"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Width="120"
                           Height="25"
                            VerticalAlignment="Bottom"
                          Margin="0,0,10,5"
                          Foreground="Black"
                          Background="#3A3A3A"
                          BorderBrush="#707070"
                          SelectedItem="{Binding Genre4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding Genres}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding name}" 
                                       Foreground="Black" 
                                       FontSize="14"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Grid>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Cancel"
            Margin="0,0,10,0"
            Command="{Binding DataContext.CloseListItemDetailViewCommand,
                              RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Content="Save"
                    Command="{Binding SaveListItemCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Delete"
                    Margin="10,0,10,0"
                    Command="{Binding DeleteListItemCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNewItem}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Edit"
                    Margin="0,0,10,0"
                    Command="{Binding DataContext.OpenListItemDetailViewEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
