<UserControl x:Class="Bookmark_App.Views.ListItemDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Bookmark_App.Views" xmlns:viewmodels="clr-namespace:Bookmark_App.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:ListItemDetailViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#555"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4a4a4a"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlatComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#444"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                            </Grid.ColumnDefinitions>

                            <!-- flat square border -->
                            <Border x:Name="Border"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0"
                                    Padding="4" />

                            <!-- selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="3,0,4,0"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center" />

                            <!-- toggle button with hollow 'V' arrow -->
                            <ToggleButton Grid.Column="1"
                                          Focusable="false"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Width="20" Height="20"
                                          Padding="0" Margin="0">
                                <Viewbox Width="12" Height="12">
                                    <!-- V shape (outlined) -->
                                    <Path Data="M1,2 L6,8 L11,2"
                                          Fill="Transparent"
                                          Stroke="White"
                                          StrokeThickness="1.4"
                                          StrokeLineJoin="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          Stretch="Uniform" />
                                </Viewbox>
                            </ToggleButton>

                            <!-- popup; ensure it matches combobox width -->
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <!-- Title Field -->
        <TextBlock Text="{Binding HeaderTitle}"
               Foreground="White"
               FontSize="24"
               FontWeight="Bold"
               Margin="0,0,0,20" 
               HorizontalAlignment="Center"/>
        <Grid> <!-- Detail View when IsEditMode = False-->
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property= "Visibility"  Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Information Fields -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Title:"
                   Foreground="White"/>
                    <Border Width="130"
                            Height="40"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <TextBlock Width="125"
                                        Height="40"
                                        TextWrapping="Wrap"
                                        Text="{Binding CurrentListItem.title, UpdateSourceTrigger=PropertyChanged}" 
                                        Foreground="White"       
                                        Margin="3,0,0,0"/>
                        </ScrollViewer>
                    </Border>
                    
                    <TextBlock Text="Current Progress:"
                   Foreground="White"/>
                    <Border Width="130"
                            Height="18"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <TextBlock Width="130"
                                   Text="{Binding CurrentListItem.progressCurrent, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,0,0,0"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Rating:"
                   Foreground="White"/>
                    <Border Width="130"
                            Height="18"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <TextBlock Width="125"
                                   Text="{Binding CurrentListItem.rating, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,0,0,0"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Url:"
                   Foreground="White"/>
                    <Border Width="130"
                            Height="40"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden">
                            <TextBlock Width="125"
                                   TextWrapping="Wrap"
                                   Text="{Binding CurrentListItem.url, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,0,0,0"
                                   Foreground="White"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="Max Progress:"
                    Foreground="White"/>
                    <Border Width="130"
                            Height="18"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <TextBlock Width="130"
                                   Text="{Binding CurrentListItem.progressMax, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,0,0,0"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Text="Status:"
                   Foreground="White"/>
                    <Border Width="130"
                            Height="18"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,0,10">
                        <TextBlock Width="130"
                                   Text="{Binding CurrentListItem.status, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,0,0,0"
                                   Foreground="White"/>
                    </Border>


                </StackPanel>
                <!-- Rechter kant: uploadvak -->
                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">

                    <!-- Vak met afbeelding of placeholder -->
                    <Border Width="145"
                            Height="145"
                            CornerRadius="75"
                            BorderBrush="#666"
                            BorderThickness="1"
                            
                            ClipToBounds="True"
                            Margin="0,0,0,115">
                        
                        <!-- Preview-image -->
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentListItem.coverImage}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentListItem.coverImage}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#333"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <!-- Placeholder -->
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <!-- standaard verborgen -->
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- Als CoverPreview null is → tonen -->
                                            <DataTrigger Binding="{Binding CurrentListItem.coverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="No image found"
                                           Foreground="#AAAAAA"
                                           TextAlignment="Center"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Press 'Edit' to add an image"
                                           Foreground="#777"
                                           FontSize="11"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Vertical"> 
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                        <TextBlock Text="Genres:"
                                   Foreground="White"
                                   Margin="0,0,0,0"/>
                        <Border Width="130"
                                Height="25"
                                Background="#1f1f1f"
                                CornerRadius="6"
                                Margin="0,0,65,0">
                            <TextBlock Width="120"
                                       Height="25"
                                       FontSize="14"
                                       Text="{Binding CurrentListItem.genres[0].name, UpdateSourceTrigger=PropertyChanged}" 
                                       Margin="3,2,0,0"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <Border Width="130"
                            Height="25"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,65,0"
                            VerticalAlignment="Bottom">
                        <TextBlock Width="120"
                                   Height="25"
                                   FontSize="14"
                                   Text="{Binding CurrentListItem.genres[1].name, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,2,0,0"
                                   Foreground="White"/>
                    </Border>
                    <Border Width="130"
                            Height="25"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Bottom">
                        <TextBlock Width="120"
                                     Height="25"
                                     FontSize="14"
                                     Text="{Binding CurrentListItem.genres[2].name, UpdateSourceTrigger=PropertyChanged}" 
                                     Margin="3,2,0,0"
                                     Foreground="White"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                        <Border Width="130"
                                Height="25"
                                Background="#1f1f1f"
                                CornerRadius="6"
                                Margin="0,0,65,0">
                            <TextBlock Width="120"
                                       Height="25"
                                       FontSize="14"
                                       Text="{Binding CurrentListItem.genres[3].name, UpdateSourceTrigger=PropertyChanged}" 
                                       Margin="3,2,0,0"
                                       Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <Border Width="130"
                            Height="25"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,65,0"
                            VerticalAlignment="Bottom">
                        <TextBlock Width="120"
                                   Height="25"
                                   FontSize="14"
                                   Text="{Binding CurrentListItem.genres[4].name, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,2,0,0"
                                   Foreground="White"/>
                    </Border>
                    <Border Width="130"
                            Height="25"
                            Background="#1f1f1f"
                            CornerRadius="6"
                            Margin="0,0,10,0"
                            VerticalAlignment="Bottom">
                        <TextBlock Width="120"
                                   Height="25"
                                   FontSize="14"
                                   Text="{Binding CurrentListItem.genres[5].name, UpdateSourceTrigger=PropertyChanged}" 
                                   Margin="3,2,0,0"
                                   Foreground="White"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid> <!-- Edit Mode when IsEditMode = True-->    
            <Grid.RowDefinitions>
                <RowDefinition Height="8*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property= "Visibility"  Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Information Fields -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="Title:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Height="40"
                             TextWrapping="Wrap"
                             Text="{Binding CurrentListItem.title, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,10"
                             Foreground="White"
                             Background="#444"
                             BorderBrush="#333"/>
                    <TextBlock Text="Current Progress:"
                               Foreground="White"/>
                    <TextBox Width="130"
                             Text="{Binding CurrentListItem.progressCurrent, UpdateSourceTrigger=LostFocus}" 
                             Margin="0,0,0,10"
                             Foreground="White"
                             Background="#444"
                             BorderBrush="#333"/>
                    <TextBlock Text="Rating:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Text="{Binding CurrentListItem.rating, UpdateSourceTrigger=LostFocus}" 
                             Margin="0,0,0,10"
                             Foreground="White"
                             Background="#444"
                             BorderBrush="#333"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Url:"
                                Foreground="White"/>
                    <TextBox Width="130"
                             Height="40"
                             TextWrapping="Wrap"
                             Text="{Binding CurrentListItem.url, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,10,10"
                             Foreground="White"
                             Background="#444"
                             BorderBrush="#333"/>
                    <TextBlock Text="Max Progress:"
                               Foreground="White"/>
                    <TextBox Width="130"
                             Text="{Binding CurrentListItem.progressMax, UpdateSourceTrigger=LostFocus}" 
                             Margin="0,0,10,10"
                             Foreground="White"
                             Background="#444"
                             BorderBrush="#333"/>
                    <TextBlock Text="Status:"
                               Foreground="White"/>
                    <ComboBox Width="130"
                              Margin="0,0,10,5"
                              Height="20"
                              Style="{StaticResource FlatComboBox}"
                              SelectedValue="{Binding CurrentListItem.status, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Statuses}"/>


                </StackPanel>
                <!-- Rechter kant: uploadvak -->
                <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                    <!-- Field with image or placeholder -->
                    <Border Width="145"
                            Height="145"
                            CornerRadius="75"
                            BorderBrush="#666"
                            BorderThickness="1"
                            Margin="0,0,0,10"
                            ClipToBounds="True">

                        <!-- Image Preview -->
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentListItem.coverImage}"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentListItem.coverImage}" Value="{x:Null}">
                                        <Setter Property="Background" Value="#333"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>

                            <!-- Placeholder -->
                            <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <!-- standaard verborgen -->
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!-- Als CoverPreview null is → tonen -->
                                            <DataTrigger Binding="{Binding CurrentListItem.coverImage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <TextBlock Text="No image selected"
                                   Foreground="#AAAAAA"
                                   TextAlignment="Center"
                                   Margin="0,0,0,4"/>
                                <TextBlock Text="Press 'Upload Image'"
                                   Foreground="#777"
                                   FontSize="11"
                                   TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Upload-knop -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,115">
                        <Button Content="Upload Image"
                                Command="{Binding SelectImageCommand}"
                                Padding="12,4"
                                HorizontalAlignment="Center"
                                Margin="0,0,10,0"
                                Foreground="White"
                                Background="#444"
                                BorderBrush="#444"/>
                        <Button Content="Remove Image"
                                Command="{Binding RemoveImageCommand}"
                                Padding="12,4"
                                HorizontalAlignment="Center"
                                Foreground="White"
                                Background="#444"
                                BorderBrush="#444"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Vertical">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" >
                        <TextBlock Text="Genres:"
                                   Foreground="White"
                                   Margin="0,0,0,0"/>
                        <ComboBox Width="120"
                                  Height="25"
                                  Style="{StaticResource FlatComboBox}"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,75,5"
                                  SelectedItem="{Binding Genre1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding Genres}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding name}"  
                                               FontSize="14"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <ComboBox Width="120"
                              Height="25"
                              Style="{StaticResource FlatComboBox}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,75,5"
                              SelectedItem="{Binding Genre2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}"  
                                           FontSize="14"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="120"
                              Height="25"
                              Style="{StaticResource FlatComboBox}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,10,5"
                              SelectedItem="{Binding Genre3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}"  
                                           FontSize="14"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <ComboBox Width="120"
                              Height="25"
                              Style="{StaticResource FlatComboBox}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,75,5"
                              SelectedItem="{Binding Genre4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}"  
                                            FontSize="14"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="120"
                            Height="25"
                            Style="{StaticResource FlatComboBox}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,75,5"
                            SelectedItem="{Binding Genre5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}"  
                                            FontSize="14"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="120"
                              Height="25"
                              Style="{StaticResource FlatComboBox}"
                              VerticalAlignment="Bottom"
                              Margin="0,0,10,5"
                              SelectedItem="{Binding Genre6, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ItemsSource="{Binding Genres}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding name}"  
                                           FontSize="14"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Grid>


        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Button Content="Cancel"
                    Margin="0,0,10,0"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Command="{Binding DataContext.CloseListItemDetailViewCommand,
                                      RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Content="Save"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Command="{Binding SaveListItemCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Delete"
                    Margin="10,0,10,0"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Command="{Binding DeleteListItemCommand}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNewItem}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="Edit"
                    Margin="0,0,10,0"
                    Foreground="White"
                    Background="#444"
                    BorderBrush="#444"
                    Command="{Binding DataContext.OpenListItemDetailViewEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
